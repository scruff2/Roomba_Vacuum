# Not "sweep": an unrelated sound editor in the AUR has that name, and AUR
# updates (yay) would replace this app with it.
pkgname=roomba-sweep
pkgver=0.1.0
pkgrel=1
pkgdesc='Desktop control center for a Roomba: history, automations, settings and health'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
# Both install /usr/bin/sweep.
conflicts=('sweep')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/sweep "$pkgdir/usr/bin/sweep"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/sweep.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/sweep.svg"
  install -Dm644 "$startdir/sweep.desktop" "$pkgdir/usr/share/applications/sweep.desktop"
}
